# Copy to .env (NEVER commit .env). All values are placeholders — fill them in.

# ─── Supabase ──────────────────────────────────────────────────────────────
# Project URL is fine to commit publicly. Service key is NOT.
SUPABASE_URL=https://lcyqbwjcchpssvghnvgz.supabase.co
SUPABASE_SERVICE_KEY=REPLACE_WITH_SUPABASE_SERVICE_KEY
# Postgres connection string used by n8n's Postgres credential.
# Find it in Supabase → Project Settings → Database → Connection string (URI).
SUPABASE_PG_CONN=REPLACE_WITH_SUPABASE_PG_CONN

# ─── n8n ───────────────────────────────────────────────────────────────────
# Public URL where Clay can POST back to the workflow's wait webhook.
# When self-hosting on Hetzner, this is your domain or VPS public IP + :5678.
N8N_BASE_URL=REPLACE_WITH_N8N_BASE_URL
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_TIMEZONE=Europe/London

# ─── Clay ──────────────────────────────────────────────────────────────────
# The "Webhook" source URL on the BESS_developers table (Sources → Add → Webhook).
CLAY_WEBHOOK_URL=REPLACE_WITH_CLAY_WEBHOOK_URL
# Optional, only if you script table creation.
CLAY_API_KEY=REPLACE_WITH_CLAY_API_KEY

# ─── Slack ─────────────────────────────────────────────────────────────────
# Incoming webhooks. If you only use one channel, set both vars to the same URL.
SLACK_WEBHOOK_TIER1=REPLACE_WITH_SLACK_WEBHOOK_TIER1
SLACK_WEBHOOK_TIER2=REPLACE_WITH_SLACK_WEBHOOK_TIER2

# ─── TED ───────────────────────────────────────────────────────────────────
# Free key from https://ted.europa.eu/en/ → Developer portal.
TED_API_KEY=REPLACE_WITH_TED_API_KEY
